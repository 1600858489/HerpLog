# Docker PostgreSQL initialization; set a local-only password in .env.
POSTGRES_USER=herplog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=herplog

# Used by locally started backend scripts after `--profile dev` publishes ports.
DATABASE_URL=postgresql+asyncpg://herplog:change-me@127.0.0.1:5432/herplog
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_HEALTH_CHECK_INTERVAL=30

# Use a separate database for tests.
TEST_DATABASE_URL=postgresql+asyncpg://herplog:change-me@127.0.0.1:5432/herplog_test
